# Copy to .env and fill in. Never commit .env.

# --- Claude API ---
ANTHROPIC_API_KEY=

# Model IDs are pinned deliberately: eval numbers are only attributable to a
# configuration if the models are fixed. Do not float these to "latest".
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_STRONG=claude-sonnet-5

# --- Postgres + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kontrakt_guard
POSTGRES_USER=kontrakt
POSTGRES_PASSWORD=

# --- Embeddings ---
# Revision is pinned alongside the model name so a silent upstream re-upload
# cannot invalidate historical recall@k numbers.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_REVISION=
EMBEDDING_DEVICE=cpu

# --- Eval cost control ---
# Hard ceiling per eval run, enforced before the run starts.
EVAL_MAX_COST_USD=5.0
